<div id="lobby" class="hidden"><div class="card">
  <h2>Preparar o golpe</h2>
  <div class="small" id="lobbyShare">Partilhe este código com os amigos (até 4 ladrões):</div>
  <div class="bigcode" id="lobbyCode">----</div>
  <div class="row" style="margin-top:0"><button id="btnCopy" class="ghost">Copiar convite</button></div>
  <ul id="lobbyPlayers"></ul>
  <div id="lvlName"></div>
  <div id="lvlSel"></div>
  <div class="small" id="lobbyHint"></div>
  <div class="row"><button id="btnStart">Começar o golpe</button></div>
  <div class="row" style="margin-top:8px"><button id="btnHq" class="ghost">Voltar ao esconderijo</button></div>
</div></div>

<div id="roomBadge" class="hidden"></div>
<div id="options" class="screen hidden"><div class="card" style="width:min(460px,94vw)">
  <div id="pauseHead"><img id="pauseCover" alt=""><div><b id="pauseName"></b><small id="pauseSub"></small></div></div>
  <div id="pauseMain">
    <button id="pmResume">Continuar</button>
    <button id="pmInvite" class="ghost">Convidar amigos <small>(Shift+Tab)</small></button>
    <button id="pmSettings" class="ghost">Opções de som, rato e gráficos</button>
    <button id="pmHq" class="ghost hidden">Voltar ao esconderijo</button>
    <button id="pmLeave" class="ghost">Sair para o menu</button>
    <button id="pmExit" class="ghost">Sair do jogo</button>
  </div>
  <h1 id="optTitle">Opções</h1>
  <div class="sub">Som, controlos e gráficos</div>
  <div class="opt"><label>Volume geral</label><input type="range" id="o_master" min="0" max="100"><span></span></div>
  <div class="opt"><label>Música</label><input type="range" id="o_music" min="0" max="100"><span></span></div>
  <div class="opt"><label>Efeitos sonoros</label><input type="range" id="o_sfx" min="0" max="100"><span></span></div>
  <div class="opt"><label>Vozes</label><input type="range" id="o_voice" min="0" max="100"><span></span></div>
  <div class="opt"><label>Ambiente</label><input type="range" id="o_amb" min="0" max="100"><span></span></div>
  <div class="opt"><label>Sensibilidade do rato</label><input type="range" id="o_sens" min="20" max="300"><span></span></div>
  <div class="opt"><label>Campo de visão</label><input type="range" id="o_fov" min="60" max="100"><span></span></div>
  <div class="opt"><label>Inverter eixo vertical</label><input type="checkbox" id="o_inv"><span></span></div>
  <div class="opt"><label>Gráficos</label><select id="o_gfx"><option value="2">Bonitos</option><option value="0">Médios</option><option value="1">Leves (PC fraco)</option></select><span></span></div>
  <div class="opt"><label>Brilho</label><input type="range" id="o_bright" min="70" max="140"><span></span></div>
  <div class="opt"><label>Mostrar FPS</label><input type="checkbox" id="o_fps"><span></span></div>
  <div id="optApp" class="hidden"></div>
  <div class="row" id="pauseRow"><button id="btnResume">Continuar</button><button id="btnQuit" class="ghost">Sair para o menu principal</button></div>
  <div class="row" id="exitRow"><button id="btnExitGame" class="ghost">Sair do jogo</button></div>
  <div class="row" id="pauseHqRow"><button id="btnPauseHq" class="ghost hidden">Voltar ao esconderijo</button></div>
  <div class="row"><button id="btnOptsClose" class="ghost">Fechar</button></div>
</div></div>

<div id="report" class="screen hidden"><div class="card">
  <h1>Relatório de Elegância</h1>
  <div class="sub" id="repReason"></div>
  <table id="repTable"></table>
  <div class="total" id="repTotal"></div>
  <div class="sub" id="repBack"></div>
  <div class="title" id="repTitle"></div>
  <div class="label">Distinções</div>
  <div class="awards" id="repAwards"></div>
  <div class="row"><button id="btnNext" class="hidden">Próximo nível ▶</button><button id="btnAgain">Jogar outra vez</button><button id="btnMenu" class="ghost">Menu principal</button></div>
</div></div>

<div id="fadeCover" style="position:fixed;inset:0;background:#000;opacity:0;pointer-events:none;z-index:85"></div>
