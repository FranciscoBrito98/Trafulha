<!doctype html>
<html lang="pt-PT">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>MALTA</title>
<link rel="icon" href="data:,">
<style>
  :root {
    --ink: #0d1a18; --bill: #14292499; --bill-solid: #142924; --bill2: #1e3a34; --line: #c8a04a; --line-dim: #c8a04a55;
    --paper: #ece4d0; --paper-dim: #ece4d0aa; --blood: #b3262e; --blood-hi: #e0454c; --mint: #8fd1ae; --amber: #e2a336;
    --display: 'Big Shoulders Display', 'Arial Narrow', sans-serif; --sans: 'Archivo', 'Segoe UI', system-ui, sans-serif;
    /* compatibilidade com estilos em linha antigos */
    --navy: #142924; --gold: #c8a04a; --gold2: #e3c47a; --cream: #ece4d0; --red: #b3262e; --green: #8fd1ae;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; overflow: hidden; background: var(--ink); font-family: var(--sans); color: var(--paper); user-select: none; }
  #app canvas { display: block; }
  .hidden { display: none !important; }
  svg.i { width: 1em; height: 1em; vertical-align: -0.14em; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  /* painel "nota de banco": fundo de tinta, filete duplo em latão */
  .panel, #room, #objectives, #status2, #help, #vitals, #toasts .toast, #prompt, #vaultUI, #clickToPlay, #mysay, .card {
    background: linear-gradient(180deg, #17302bf0, #0f201ded); border: 1px solid var(--line-dim);
    box-shadow: inset 0 0 0 3px #0d1a18, inset 0 0 0 4px #c8a04a33, 0 10px 30px #0006; border-radius: 3px; color: var(--paper);
  }

  button { font: 600 15px var(--sans); cursor: pointer; border: 1px solid var(--line); border-radius: 2px; padding: 11px 18px; background: var(--line); color: var(--ink); transition: background .12s, color .12s, transform .08s; }
  button:hover { background: #dcb862; }
  button:active { transform: translateY(1px); }
  button:focus-visible, input:focus-visible, select:focus-visible { outline: 2px solid var(--paper); outline-offset: 2px; }
  button.ghost { background: transparent; color: var(--paper); border-color: var(--line-dim); }
  button.ghost:hover { border-color: var(--line); color: #fff; background: #c8a04a1a; }
  button:disabled { opacity: .4; cursor: default; }
  input { font: 500 16px var(--sans); padding: 11px 14px; border-radius: 2px; border: 1px solid var(--line-dim); background: #0a1513; color: var(--paper); outline: none; }
  input::placeholder { color: #ece4d055; }
  input:focus { border-color: var(--line); }

  /* ---------- ecrãs ---------- */
  .screen { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; z-index: 50; }
  #loading { background: var(--ink); color: var(--paper); flex-direction: column; gap: 18px; }
  #loading .logo { width: 120px; height: 120px; }
  #loading .logo svg { width: 100%; height: 100%; }
  #loading .lt { font: 800 54px/1 var(--display); color: var(--paper); }
  #loading .ls { font-size: 14px; color: var(--paper-dim); }
  #loadbar { width: 320px; height: 3px; background: #ece4d01a; overflow: hidden; }
  #loadbar div { height: 100%; width: 0; background: var(--line); transition: width .2s; }

  /* ---------- menu principal ---------- */
  #menu { justify-content: flex-start; align-items: stretch; background: linear-gradient(90deg, #0d1a18f7 0%, #0d1a18e6 34%, #0d1a1866 62%, #0d1a1822 100%); }
  .menu-col { position: relative; width: min(560px, 100%); padding: 3vh 56px 44px; display: flex; flex-direction: column; justify-content: center; }
  .rosette { position: absolute; left: -150px; top: 50%; width: 620px; height: 620px; transform: translateY(-66%); opacity: .5; pointer-events: none; }
  .brand { position: relative; display: flex; align-items: center; gap: 22px; }
  .menu-col .logo { flex: none; width: 128px; height: 128px; filter: drop-shadow(0 6px 16px #0008); }
  .menu-col .logo svg { width: 100%; height: 100%; display: block; }
  .wordmark { position: relative; margin: 0; font-family: var(--display); font-weight: 800; line-height: .86; color: var(--paper); }
  .wordmark span { display: block; }
  .wordmark .w1 { font-size: 96px; }
  .wordmark .w2 { font-size: 24px; color: var(--line); font-weight: 700; margin-top: 10px; letter-spacing: .12em; text-transform: uppercase; }
  .wordmark .w1 { background: linear-gradient(#fbe7a6, #e0b85a 55%, #a9792a); -webkit-background-clip: text; background-clip: text; color: transparent; text-transform: uppercase; filter: drop-shadow(0 4px 0 #0a1512); }
  .tagline { position: relative; margin: 18px 0 22px; font-size: 16px; color: var(--paper-dim); max-width: 34ch; line-height: 1.45; }
  .field { position: relative; display: block; margin-bottom: 20px; }
  .field > span { display: block; font-size: 13px; color: var(--paper-dim); margin-bottom: 6px; }
  .field input { width: 100%; }
  .menu-list { position: relative; display: flex; flex-direction: column; border-top: 1px solid var(--line-dim); }
  .mi { display: grid; grid-template-columns: 1fr auto; align-items: center; text-align: left; width: 100%; background: transparent; color: var(--paper); border: 0; border-bottom: 1px solid var(--line-dim); border-radius: 0; padding: 11px 4px 11px 16px; position: relative; }
  .mi::before { content: ''; position: absolute; left: 0; top: 12px; bottom: 12px; width: 3px; background: var(--line); transform: scaleY(0); transition: transform .15s; }
  .mi:hover, .mi:focus-visible { background: #c8a04a12; color: #fff; }
  .mi:hover::before, .mi:focus-visible::before { transform: scaleY(1); }
  .mi b { font: 700 30px/1 var(--display); }
  .mi small { grid-column: 1; font: 400 13px var(--sans); color: var(--paper-dim); margin-top: 4px; }
  .mi .k { grid-row: 1 / span 2; grid-column: 2; font: 600 22px var(--display); color: var(--line); }
  .mi.join { cursor: default; }
  .mi.exit { padding-top: 7px; padding-bottom: 7px; } .mi.exit b { font-size: 21px; color: var(--paper-dim); } .mi.exit .k { font-size: 16px; } .mi.exit:hover b { color: #ff9a8a; }
  .mi.join:hover { background: transparent; }
  .joinrow { grid-column: 1 / span 2; display: flex; gap: 8px; margin-top: 10px; }
  .joinrow input { flex: 1; text-transform: uppercase; letter-spacing: .4em; text-align: center; font: 700 22px var(--display); }
  #status { position: relative; min-height: 22px; margin-top: 14px; font-size: 14px; color: var(--blood-hi); }
  #status.ok { color: var(--mint); }
  .menu-brief { position: absolute; right: 48px; bottom: 64px; width: 320px; padding: 18px 20px; }
  .menu-brief h2 { margin: 0 0 4px; font: 700 26px var(--display); color: var(--paper); }
  .menu-brief p { margin: 0 0 12px; font-size: 13px; color: var(--paper-dim); }
  .menu-brief ol { list-style: none; margin: 0; padding: 0; }
  .menu-brief li { display: grid; grid-template-columns: 34px 1fr auto; align-items: baseline; padding: 8px 0; border-top: 1px solid #c8a04a26; }
  .menu-brief li .n { font: 800 22px var(--display); color: var(--line); }
  .menu-brief li .t { font-size: 14px; font-weight: 600; }
  .menu-brief li .s { font-size: 12px; color: var(--paper-dim); }
  .menu-brief li.locked { opacity: .45; }
  .menu-foot { position: absolute; left: 56px; right: 48px; bottom: 18px; display: flex; justify-content: space-between; font-size: 11px; color: #ece4d066; }
  .ver { font-size: 11px; color: #ece4d066; }
  @media (prefers-reduced-motion: no-preference) {
    #menu:not(.hidden) .wordmark .w1 { animation: rise .7s cubic-bezier(.2,.8,.2,1) both; }
    #menu:not(.hidden) .wordmark .w2 { animation: rise .7s .12s cubic-bezier(.2,.8,.2,1) both; }
  }
  @keyframes rise { from { clip-path: inset(0 0 100% 0); transform: translateY(24px); } to { clip-path: inset(0 0 0 0); transform: none; } }
  @media (max-width: 1100px) { .menu-brief { display: none; } }

  /* cartões (lobby, opções, relatório) */
  .card { padding: 26px 30px; width: min(520px, 92vw); position: relative; background: linear-gradient(180deg, #17302b, #0f201d); }
  .card h1 { font: 800 44px/1 var(--display); margin: 0; color: var(--paper); }
  .card .sub { color: var(--paper-dim); margin: 8px 0 20px; font-size: 14px; }
  .row { display: flex; gap: 10px; margin-top: 14px; }
  .row > * { flex: 1; }
  .label { font-size: 13px; color: var(--paper-dim); margin: 16px 0 6px; font-weight: 600; }

  /* ---------- HUD ---------- */
  #hud { position: fixed; inset: 0; pointer-events: none; z-index: 10; }
  #topbar { position: absolute; top: 14px; left: 50%; transform: translateX(-50%); display: grid; grid-template-columns: 1fr auto; align-items: baseline; gap: 6px 16px; width: 460px; padding: 8px 18px 10px; background: linear-gradient(180deg, #0f201dee, #0f201dcc); border: 1px solid var(--line-dim); box-shadow: inset 0 0 0 3px #0d1a18, inset 0 0 0 4px #c8a04a33, 0 10px 30px #0006; border-radius: 3px; }
  #clock { font: 700 22px/1 var(--display); color: var(--paper); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #alarmWrap { grid-column: 1 / span 2; grid-row: 2; }
  #mult { grid-column: 2; grid-row: 1; text-align: right; white-space: nowrap; }
  #alarmWrap { display: flex; align-items: center; gap: 10px; width: 100%; }
  #alarmWrap svg { color: var(--line); font-size: 16px; flex: none; }
  #alarmBar { flex: 1; height: 4px; background: #ece4d026; position: relative; }
  #alarmBar div { height: 100%; width: 0; background: var(--amber); transition: width .2s, background .3s; }
  #alarmBar::after { content: ''; position: absolute; left: 50%; top: -3px; bottom: -3px; width: 1px; background: #ece4d088; }
  #alarmTxt { font-size: 12px; color: var(--paper-dim); width: 116px; text-align: right; flex: none; white-space: nowrap; }
  #mult { font: 600 15px var(--display); color: var(--line); }
  #hud.loud #alarmBar div { background: var(--blood-hi); }
  #hud.loud #mult { color: var(--blood-hi); }
  #room { position: absolute; top: 14px; left: 14px; padding: 10px 14px; font-size: 13px; min-width: 190px; }
  #room .rh { font-size: 12px; color: var(--paper-dim); }
  #room b.code { font: 800 26px/1.1 var(--display); color: var(--line); letter-spacing: .12em; }
  #room .pl { display: flex; align-items: center; gap: 8px; margin-top: 5px; }
  #room .dot { width: 3px; height: 14px; display: inline-block; }
  #room .pl svg { color: var(--line); }
  #objectives { display: none !important; }
  #objectivesOld { position: absolute; top: 116px; left: 14px; width: 300px; padding: 14px 16px; font-size: 13px; line-height: 1.4; }
  #objectives h3 { margin: 0 0 8px; font: 700 22px/1 var(--display); color: var(--paper); }
  #objectives .o { margin: 6px 0; padding-left: 24px; position: relative; color: var(--paper-dim); }
  #objectives .o::before { content: ''; position: absolute; left: 2px; top: 3px; width: 11px; height: 11px; border: 1px solid var(--line-dim); }
  #objectives .o.done { color: #ece4d066; text-decoration: line-through; text-decoration-color: #ece4d055; }
  #objectives .o.done::before { background: var(--mint); border-color: var(--mint); box-shadow: inset 0 0 0 2px var(--bill-solid); }
  #objectives .o.cur { color: var(--paper); font-weight: 600; }
  #objectives .o.cur::before { border-color: var(--line); background: #c8a04a33; }
  #objectives .tip { margin-top: 10px; padding-top: 8px; border-top: 1px solid #c8a04a26; font-size: 12px; color: var(--paper-dim); }
  #status2 { position: absolute; bottom: 14px; left: 14px; padding: 8px 14px; font: 700 22px var(--display); display: flex; gap: 14px; align-items: center; }
  #status2 svg { color: var(--line); }
  #help { position: absolute; bottom: 14px; right: 14px; padding: 10px 14px; font-size: 12px; line-height: 1.75; max-width: 560px; color: var(--paper-dim); }
  kbd { display: inline-block; min-width: 20px; text-align: center; background: transparent; color: var(--paper); border: 1px solid #ece4d066; border-bottom-width: 2px; border-radius: 3px; padding: 0 5px; font: 600 11px/1.5 var(--sans); }
  #prompt { position: absolute; bottom: 100px; left: 50%; transform: translateX(-50%); padding: 9px 16px 9px 10px; font-weight: 600; font-size: 15px; white-space: nowrap; display: flex; align-items: center; gap: 10px; }
  #prompt kbd { background: var(--line); color: var(--ink); border-color: var(--line); font: 800 15px/1.4 var(--display); min-width: 28px; }
  #sorry { display: none; }
  @keyframes pulse { from { filter: brightness(1); } to { filter: brightness(1.5); } }
  #escape { position: absolute; top: 96px; left: 50%; transform: translateX(-50%); color: #fff; background: var(--blood); font: 700 22px var(--display); padding: 8px 20px; border-radius: 2px; }
  #toasts { position: absolute; top: 120px; right: 14px; display: flex; flex-direction: column; gap: 6px; align-items: flex-end; width: 360px; }
  #toasts .toast { padding: 9px 14px; font-size: 13px; line-height: 1.4; border-left: 3px solid var(--line); animation: tin .22s ease-out; }
  @keyframes tin { from { opacity: 0; transform: translateX(24px); } }

  /* etiquetas e balões */
  #tags { position: fixed; inset: 0; pointer-events: none; z-index: 8; }
  .tag { position: absolute; transform: translate(-50%, -100%); text-align: center; font: 600 12px var(--sans); color: var(--paper); text-shadow: 0 1px 2px #000, 0 0 4px #000; white-space: nowrap; }
  .tag .mood { display: block; font: 700 11px var(--sans); color: var(--amber); margin-bottom: 1px; }
  .tag .extra { font-size: 11px; color: var(--line); }
  .bubble { position: absolute; transform: translate(-50%, -100%); background: var(--paper); color: var(--ink); padding: 7px 11px; border-radius: 3px; font: 600 13px/1.35 var(--sans); max-width: 240px; white-space: normal; text-align: center; box-shadow: 0 4px 12px #0007; animation: bin .18s ease-out; }
  .bubble::after { content: ''; position: absolute; left: 50%; bottom: -7px; transform: translateX(-50%); border: 7px solid transparent; border-top-color: var(--paper); border-bottom: 0; }
  @keyframes bin { from { transform: translate(-50%, -80%) scale(.7); opacity: 0; } }

  #wheel { display: none !important; }
  #vaultUI { position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 15; padding: 16px; text-align: center; width: 340px; pointer-events: none; }
  #vaultUI h3 { margin: 0 0 6px; font: 700 24px var(--display); }
  #vaultUI p { margin: 6px 0; font-size: 13px; }

  /* lobby e relatório */
  #lobby { position: fixed; right: 14px; top: 14px; width: 360px; z-index: 12; }
  #lobby .card { padding: 20px 22px; width: 100%; }
  #lobby h2 { margin: 0; font: 800 32px/1 var(--display); }
  #lobby .bigcode { font: 800 52px/1.1 var(--display); letter-spacing: .3em; text-align: center; color: var(--line); border: 1px dashed var(--line-dim); padding: 4px 0 4px .3em; margin: 10px 0; }
  #lobby ul { padding-left: 0; list-style: none; margin: 10px 0; }
  #lobby li { padding: 5px 0; display: flex; gap: 10px; align-items: center; border-top: 1px solid #c8a04a1f; font-size: 14px; }
  #lobby li .dot { width: 3px; height: 16px; }
  #lobby li small { color: var(--paper-dim); margin-left: auto; }
  #lobby .small { font-size: 12px; color: var(--paper-dim); line-height: 1.45; }
  #report .card { width: min(620px, 94vw); max-height: 92vh; overflow: auto; }
  #report h1 { font-size: 52px; }
  #report table { width: 100%; border-collapse: collapse; margin: 12px 0; font-size: 14px; }
  #report td { padding: 7px 2px; border-bottom: 1px solid #c8a04a26; color: var(--paper-dim); }
  #report td:last-child { text-align: right; font-weight: 600; color: var(--paper); }
  #report .total { font: 800 44px var(--display); text-align: center; color: var(--line); margin: 10px 0; }
  #report .title { font: 800 28px var(--display); text-align: center; color: var(--paper); border: 2px solid var(--blood-hi); color: var(--blood-hi); display: table; margin: 4px auto 14px; padding: 2px 14px; }
  #report .awards { font-size: 14px; line-height: 1.7; color: var(--paper-dim); }
  #report .awards b { color: var(--paper); }
  #crosshair { position: fixed; left: 50%; top: 50%; width: 6px; height: 6px; margin: -3px 0 0 -3px; border-radius: 50%; background: #ece4d0dd; box-shadow: 0 0 0 1px #0008; z-index: 11; pointer-events: none; transition: transform .1s, background .1s; }
  #crosshair.active { transform: scale(1.8); background: var(--line); }
  #mysay { position: fixed; left: 50%; top: calc(50% + 40px); transform: translateX(-50%); padding: 7px 14px; font: 600 14px var(--sans); z-index: 11; pointer-events: none; }
  #clickToPlay { position: fixed; left: 50%; top: 58%; transform: translateX(-50%); z-index: 13; padding: 10px 18px; font: 600 14px var(--sans); cursor: pointer; }
  #maskOverlay { position: fixed; inset: 0; z-index: 30; pointer-events: none; transform: translateY(-110%); }
  #maskOverlay svg { width: 100%; height: 100%; display: block; }
  #maskVignette { position: fixed; inset: 0; z-index: 7; pointer-events: none; box-shadow: inset 0 0 140px 30px rgba(0,0,0,.5); }
  #combatHud { position: fixed; z-index: 11; pointer-events: none; }
  #vitals { position: fixed; left: 14px; bottom: 66px; width: 250px; padding: 10px 14px; }
  #vitals .vr { display: grid; grid-template-columns: 18px 1fr 40px; align-items: center; gap: 8px; margin: 3px 0; }
  #vitals .vr svg { font-size: 15px; }
  #vitals .vr span { font: 700 20px var(--display); text-align: right; }
  #vitals .bar { height: 6px; background: #ece4d01f; overflow: hidden; }
  #hpBar { height: 100%; background: var(--blood-hi); transition: width .15s; }
  #armorBar { height: 100%; background: #9cc3d6; transition: width .15s; }
  #vitals .hp svg { color: var(--blood-hi); } #vitals .ar svg { color: #9cc3d6; }
  #ammo { position: fixed; right: 0; bottom: 96px; padding: 26px 18px 16px 90px; text-align: right; color: var(--paper); text-shadow: 0 2px 6px #000; background: radial-gradient(farthest-side at 100% 60%, #0d1a18cc, #0d1a1866 55%, transparent); }
  #ammo .wname { font: 600 18px var(--display); color: var(--line); }
  #ammo .mag { font: 800 64px/0.95 var(--display); color: #fff; }
  #ammo .res { font: 600 26px var(--display); color: var(--paper-dim); }
  #ammo .rl { font: 600 13px var(--sans); color: var(--amber); }
  #ammo .kit { display: flex; gap: 14px; justify-content: flex-end; align-items: center; font: 700 20px var(--display); margin-top: 4px; }
  #ammo .kit svg { color: var(--line); }
  #ammo .keys { font-size: 11px; color: var(--paper-dim); margin-top: 6px; }
  #waveInfo { position: fixed; top: 86px; background: #0f201dd9; padding: 3px 12px; border-radius: 2px; left: 50%; transform: translateX(-50%); color: var(--paper); font: 600 16px var(--display); text-shadow: 0 2px 4px #000; white-space: nowrap; }
  #waveInfo svg { color: var(--blood-hi); }
  #downed { position: fixed; top: 34%; left: 50%; transform: translateX(-50%); z-index: 14; text-align: center; color: #fff; font: 800 52px var(--display); text-shadow: 0 3px 10px #000; pointer-events: none; }
  #downed small { display: block; font: 500 15px var(--sans); color: var(--paper); margin-top: 6px; }
  #downed .rev, #reviveBar { width: 260px; height: 6px; background: #0008; margin: 12px auto 0; overflow: hidden; }
  #downed .rev div, #reviveBar div { height: 100%; background: var(--mint); }
  #reviveBar { position: fixed; top: 58%; left: 50%; transform: translateX(-50%); z-index: 14; }
  #hurt { position: fixed; inset: 0; z-index: 6; pointer-events: none; opacity: 0; box-shadow: inset 0 0 200px 80px rgba(170,0,0,.7); }
  #hurtDir { position: fixed; left: 50%; top: 50%; width: 0; height: 0; z-index: 12; pointer-events: none; opacity: 0; transition: opacity .3s; }
  #hurtDir::before { content: ''; position: absolute; left: -40px; top: -160px; width: 80px; height: 20px; border-radius: 50% 50% 0 0; background: rgba(224,69,76,.85); }
  #hitmark { position: fixed; left: 50%; top: 50%; width: 30px; height: 30px; margin: -15px 0 0 -15px; z-index: 12; pointer-events: none; opacity: 0; transition: opacity .1s; }
  #hitmark::before, #hitmark::after { content: ''; position: absolute; left: 14px; top: 0; width: 2px; height: 30px; background: #fff; transform: rotate(45deg); box-shadow: 0 0 3px #000; -webkit-mask: linear-gradient(#000 35%, transparent 35% 65%, #000 65%); mask: linear-gradient(#000 35%, transparent 35% 65%, #000 65%); }
  #hitmark::after { transform: rotate(-45deg); }
  #hitmark.head::before, #hitmark.head::after { background: var(--line); }
  #hitmark.kill::before, #hitmark.kill::after { background: var(--blood-hi); width: 3px; }
  .dmg { position: absolute; transform: translate(-50%, -50%); font: 800 24px var(--display); color: #fff; text-shadow: 0 2px 3px #000; pointer-events: none; animation: dmgPop .25s cubic-bezier(.2,2,.4,1); }
  .dmg.head { color: var(--line); font-size: 30px; }
  .dmg.kill { color: var(--blood-hi); font-size: 34px; }
  @keyframes dmgPop { 0% { transform: translate(-50%, -50%) scale(2.2); } 100% { transform: translate(-50%, -50%) scale(1); } }
  #crosshair.gun { width: 4px; height: 4px; margin: -2px 0 0 -2px; }
  .opt { display: grid; grid-template-columns: 200px 1fr 46px; align-items: center; gap: 12px; margin: 10px 0; font-size: 14px; }
  .opt input[type=range] { accent-color: var(--line); padding: 0; border: 0; background: transparent; }
  .opt span { text-align: right; color: var(--paper-dim); font: 600 16px var(--display); }
  .opt select { font: 500 14px var(--sans); padding: 7px; border-radius: 2px; border: 1px solid var(--line-dim); background: #0a1513; color: var(--paper); }
  #options { z-index: 60; background: #0d1a18b3; }
  #options.ingame { background: #0d1a1855; pointer-events: none; }
  #options.ingame .card { pointer-events: auto; }
  #btnGear { position: fixed; top: 14px; right: 14px; z-index: 13; padding: 7px 9px; font-size: 18px; line-height: 0; pointer-events: auto; background: var(--bill-solid); color: var(--paper); border-color: var(--line-dim); }
