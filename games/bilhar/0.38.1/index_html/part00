<div id="app"></div>
<div id="flash"></div>
<div id="announce"></div>
<div id="speedlines"></div>
<div id="xhair" class="hidden"><i></i><i></i><i></i><i></i></div>
<div id="hurt"></div>
<div id="maskVignette" class="hidden"></div>
